* DEFINITIONS                                                                   
* -----------                                                                   
define/XL/100000                                                                
define/YL/100000                                                                
define/ZL/50000                                                                 
define/XL_back/-50000                                                           
define/YL_back/-50000                                                           
define/XL_front/50000                                                           
define/YL_front/50000                                                           
define/NX/101                                                                   
define/NY/101                                                                   
define/NZ/1                                                                     
# seafloor                                                                      
define/ZSURF0/25000                                                             
# sediment base                                                                 
define/ZSURF1/20000                                                             
# aquifer base                                                                  
define/ZSURF2/10000                                                             
# basement base                                                                 
define/ZSURF3/-25000                                                            
