define / XL / 100000
define / YL / 100000
define / ZL / 50000

define / NX / 101
define / NY / 101
define / NZ / 1

cmo / create / mo_mesh / / / tet
createpts / xyz / NX NY NZ / 0. 0. 0. / XL YL ZL
cmo / setatt / mo_mesh / imt / 1 0 0 / 1
connect
resetpts / itp

read / avs / tmp_surf0.inp / mo0
cmo / printatt / mo0 / -xyz- / minmax
read / avs / tmp_surf1.inp / mo1
cmo / printatt / mo1 / -xyz- / minmax
read / avs / tmp_surf2.inp / mo2
cmo / printatt / mo2 / -xyz- / minmax
read / avs / tmp_surf3.inp / mo3
cmo / printatt / mo3 / -xyz- / minmax

surface/s0/reflect/sheet/ mo0
surface/s1/reflect/sheet/ mo1
surface/s2/reflect/sheet/ mo2
surface/s3/reflect/sheet/ mo3

cmo / select / mo_mesh
region / r1 / gt s0 and le s1
region / r2 / gt s1 and le s2
region / r3 / gt s2 and le s3

pset / p1 / region r1 / 1 0 0
pset / p2 / region r2 / 1 0 0
pset / p3 / region r3 / 1 0 0

cmo / setatt / mo_mesh / imt / pset get p1 / 1
cmo / setatt / mo_mesh / imt / pset get p2 / 2
cmo / setatt / mo_mesh / imt / pset get p3 / 3

dump / avs / tmp_mesh.inp / mo_mesh

dump / fehm / mesh / mo_mesh

finish
